---
import type { Photo } from "../config";

interface Props {
  photo: Photo;
  sizes: string;
  class?: string;
  eager?: boolean;
}

const { photo, sizes, class: className, eager = false } = Astro.props;

const url = (width: number) => `/optimized/${photo.name}-${width}.webp`;
const fallback = photo.widths.includes(1600) ? 1600 : photo.widths[0];
---

<img
  src={url(fallback)}
  srcset={photo.widths.map((w) => `${url(w)} ${w}w`).join(", ")}
  sizes={sizes}
  alt={photo.alt}
  width={photo.width}
  height={photo.height}
  class={className}
  loading={eager ? "eager" : "lazy"}
  fetchpriority={eager ? "high" : undefined}
  decoding="async"
/>

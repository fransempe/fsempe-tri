---
import IronmanLogo from "./IronmanLogo.astro";
import type { TimelineYear } from "../data/results-timeline";

interface Props {
  blocks: TimelineYear[];
}

const { blocks } = Astro.props;

const sorted = [...blocks].sort((a, b) => parseInt(a.year, 10) - parseInt(b.year, 10));
---

<div class="space-y-14 md:space-y-20">
  {
    sorted.map((block) => (
      <section class="md:grid md:grid-cols-[minmax(0,2fr)_minmax(0,10fr)] md:gap-x-8" aria-label={`Resultados ${block.year}`}>
        <h3 class="display tiempo mb-4 self-start text-6xl not-italic text-azur md:sticky md:top-20 md:mb-0 lg:text-8xl">
          {block.year}
        </h3>

        <ol class="m-0 list-none p-0">
          {block.events.map((ev) => (
            <li
              class:list={[
                "grid gap-x-6 gap-y-3 py-5 sm:grid-cols-[minmax(0,1fr)_minmax(0,14rem)]",
                ev.featured
                  ? "-mx-4 bg-azur px-4 text-white sm:-mx-5 sm:px-5"
                  : "border-b border-asfalto/25 first:border-t-4 first:border-t-asfalto",
              ]}
            >
              <div class="min-w-0">
                <h4 class="text-balance text-xl font-bold leading-tight lg:text-2xl">{ev.title}<IronmanLogo race={ev.title} white={ev.featured} /></h4>
                {ev.distance && (
                  <p class:list={["mt-1 text-sm", ev.featured ? "text-white/85" : "text-asfalto/70"]}>{ev.distance}</p>
                )}
              </div>
              <div class="min-w-0 sm:text-right">
                {ev.time && <p class:list={["tiempo mb-1 text-4xl lg:text-5xl", ev.featured ? "text-sol" : "text-azur"]}>{ev.time}</p>}
                <ul class="m-0 list-none space-y-0.5 p-0 text-sm font-medium lg:text-base">
                  {ev.lines.map((line) => (
                    <li>{line}</li>
                  ))}
                </ul>
              </div>
            </li>
          ))}
        </ol>
      </section>
    ))
  }
</div>

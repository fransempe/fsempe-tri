---
import Photo from "./Photo.astro";
import type { Photo as PhotoData } from "../config";

interface Props {
  images: PhotoData[];
}

const { images } = Astro.props;

if (!images?.length) {
  return null;
}

const buttonClass =
  "flex h-12 w-12 items-center justify-center bg-sol text-asfalto transition-colors hover:bg-white";
---

<div data-carousel class="min-w-0 w-full">
  <div
    data-track
    class="filmstrip flex snap-x snap-mandatory gap-2 overflow-x-auto overscroll-x-contain scroll-smooth scroll-pl-4 px-4 pb-4 sm:scroll-pl-8 sm:px-8 lg:scroll-pl-12 lg:px-12"
    tabindex="0"
    role="region"
    aria-roledescription="carrusel"
    aria-label="Galería de imágenes"
  >
    {
      images.map((img) => (
        <figure class="m-0 shrink-0 snap-start">
          <Photo
            photo={img}
            sizes="(max-width: 640px) 88vw, 70vw"
            class="h-[min(62svh,640px)] w-auto max-w-[88vw] object-cover"
          />
          <figcaption class="mt-2 max-w-[80vw] text-sm text-dorsal/80 sm:max-w-md">{img.alt}</figcaption>
        </figure>
      ))
    }
  </div>

  <div class="mt-4 flex justify-end gap-2 px-4 sm:px-8 lg:px-12">
    <button type="button" data-direction="-1" class={buttonClass} aria-label="Imagen anterior">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" aria-hidden="true"><path d="M15 4l-8 8 8 8"></path></svg>
    </button>
    <button type="button" data-direction="1" class={buttonClass} aria-label="Imagen siguiente">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" aria-hidden="true"><path d="M9 4l8 8-8 8"></path></svg>
    </button>
  </div>
</div>

<script>
  document.querySelectorAll<HTMLElement>("[data-carousel]").forEach((carousel) => {
    const track = carousel.querySelector<HTMLElement>("[data-track]");
    carousel.querySelectorAll<HTMLButtonElement>("[data-direction]").forEach((button) => {
      button.addEventListener("click", () => {
        track?.scrollBy({ left: Number(button.dataset.direction) * track.clientWidth * 0.8 });
      });
    });
  });
</script>

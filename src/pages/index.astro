---
import LandingLayout from "../layouts/LandingLayout.astro";
import ImageCarousel from "../components/ImageCarousel.astro";
import IronmanLogo from "../components/IronmanLogo.astro";
import Photo from "../components/Photo.astro";
import ResultsTimeline from "../components/ResultsTimeline.astro";
import { RESULTS_TIMELINE } from "../data/results-timeline";
import { SITE_TITLE, SITE_DESCRIPTION, CONTACT_EMAIL, INSTAGRAM_URL, WHATSAPP_URL, CAROUSEL_IMAGES, PHOTOS } from "../config";

const GUTTER = "px-4 sm:px-8 lg:px-12";
const SECTION = `scroll-mt-14 py-16 md:py-24 ${GUTTER}`;
const HEADING = "display text-[clamp(3.25rem,10vw,8.5rem)]";

const DISTANCES = [
  ["1,9 km", "Natación"],
  ["90 km", "Bici"],
  ["21,1 km", "Carrera"],
];

type Achievement = { date: string; title: string; detail?: string; featured?: boolean };

const ACHIEVEMENTS: Achievement[] = [
  { date: "2026", title: "Mundial IRONMAN 70.3 – Niza, Francia", detail: "Participación en el Mundial", featured: true },
  { date: "2025", title: "Ironman Brasil (Full)", detail: "Finisher (debut)", featured: true },
  { date: "2026", title: "Ironman 70.3 San Juan", detail: "13° categoría 40–44 · Clasificación al Mundial", featured: true },
  { date: "2025", title: "Duatlón Punta Mogotes", detail: "Podio general" },
  { date: "2025–2026", title: "Múltiples podios categoría 40–44", detail: "Short y Sprint" },
  { date: "2024", title: "Ironman 70.3 Buenos Aires", detail: "Top 10% masculino" },
  { date: "2024–2026", title: "Alta consistencia competitiva", detail: "Mar del Plata + Tandil" },
];

const COMMITMENTS = ["Alto rendimiento", "Entrenamiento constante", "Mejora continua", "Disciplina y mentalidad competitiva"];

const UPCOMING = [
  {
    year: "2026",
    races: [
      { date: "29 de noviembre", title: "Olímpico de Mar del Plata (MMS)" },
      { date: "13 de diciembre", title: "ISS Sprint Mar del Plata" },
    ],
  },
  {
    year: "2027",
    featured: true,
    races: [
      { date: "Junio", title: "Ironman Brasil" },
      { date: "Noviembre", title: "Ironman Full San Juan", detail: "Buscando la plaza para Hawaii, Kona" },
    ],
  },
];

const GOALS = ["Performance competitiva internacional", "Mejorar tiempos en media distancia", "Consolidación en categoría 40–44"];

const OFFER = [
  "Presencia en redes (entrenamiento + competencia + lifestyle)",
  "Contenido audiovisual (previo y durante cada competencia)",
  "Exposición de marca en carreras",
  "Storytelling del proceso deportivo",
];

const CONTACT_LINK =
  "flex min-h-16 items-center justify-between gap-4 border-b-2 border-white/40 py-4 text-xl font-bold transition-colors hover:border-sol hover:text-sol sm:text-3xl";
---

<LandingLayout title={SITE_TITLE} description={SITE_DESCRIPTION}>
  <!-- Hero: la meta de Niza y su tablero -->
  <section id="inicio" class="flex min-h-[calc(100svh-3.5rem)] flex-col">
    <div class="relative min-h-[56svh] flex-1 overflow-hidden bg-azur">
      <Photo
        photo={PHOTOS.finishNice}
        sizes="100vw"
        eager
        class="absolute inset-0 h-full w-full object-cover object-[47%_100%]"
      />
      <h1 class="sr-only">Francisco Sempé, triatleta amateur</h1>
    </div>

    <div class={`grid items-center gap-x-10 gap-y-3 bg-asfalto py-4 lg:grid-cols-2 lg:py-5 ${GUTTER}`}>
      <div class="flex items-center gap-3">
        <svg class="h-8 w-12 shrink-0" viewBox="0 0 30 20" role="img" aria-label="Bandera argentina">
          <rect width="30" height="20" fill="#74acdf"></rect>
          <rect y="6.67" width="30" height="6.66" fill="#fff"></rect>
          <circle cx="15" cy="10" r="2.3" fill="#f6b40e"></circle>
        </svg>
        <p class="font-semibold leading-tight">
          IRONMAN 70.3 World Championship<IronmanLogo race="IRONMAN" />
          <span class="block font-normal text-dorsal/80">Niza, Francia · 2026</span>
        </p>
      </div>

      <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between lg:flex-col lg:items-end">
        <p class="leading-tight lg:text-right">
          Triatleta amateur
          <span class="block text-dorsal/80">Mar del Plata, Argentina · Categoría 40–44</span>
        </p>
        <a href="#sponsorship" class="bg-sol px-5 py-3 text-center font-bold text-asfalto transition-colors hover:bg-white">
          Ver propuesta de sponsorship
        </a>
      </div>
    </div>
  </section>

  <!-- Niza -->
  <section id="niza" class="scroll-mt-14 bg-azur pt-16 text-white md:pt-24">
    <div class={`grid gap-10 lg:grid-cols-12 lg:gap-x-8 ${GUTTER}`}>
      <div class="lg:col-span-7 lg:pb-24">
        <h2 class={HEADING}>Niza 2026. Mi mayor logro.</h2>
        <p class="mt-8 max-w-[60ch] text-lg leading-relaxed sm:text-xl">
          Participar del Mundial IRONMAN 70.3 en Niza, Francia, es lo más grande que hice en el deporte. Llegué clasificado desde el
          Ironman 70.3 San Juan y completé los 113 km.
        </p>
        <dl class="mt-10 grid grid-cols-3 gap-4 border-t-4 border-white pt-4">
          {
            DISTANCES.map(([value, label]) => (
              <div class="flex flex-col-reverse justify-end gap-1">
                <dt class="text-sm font-medium sm:text-base">{label}</dt>
                <dd class="tiempo m-0 text-[clamp(2.25rem,7vw,5rem)]">{value}</dd>
              </div>
            ))
          }
        </dl>
      </div>
      <Photo
        photo={PHOTOS.runNice}
        sizes="(min-width: 1024px) 40vw, 100vw"
        class="relative z-10 h-auto w-full lg:col-span-5 lg:-mb-40"
      />
    </div>
    <Photo photo={PHOTOS.bikeNice} sizes="100vw" class="mt-10 h-[60svh] w-full object-cover object-[50%_35%] lg:mt-0 lg:h-[85svh]" />
  </section>

  <!-- Perfil -->
  <section id="perfil" class={`on-dorsal bg-dorsal text-asfalto ${SECTION}`}>
    <div class="grid gap-10 lg:grid-cols-12 lg:gap-x-8">
      <Photo
        photo={PHOTOS.profile}
        sizes="(min-width: 1024px) 33vw, 100vw"
        class="h-auto max-h-[80svh] w-full object-cover object-top lg:col-span-4"
      />
      <div class="lg:col-span-8 lg:pl-8">
        <h2 class={`${HEADING} text-azur`}>Perfil deportivo</h2>
        <div class="mt-8 max-w-[62ch] space-y-5 text-lg leading-relaxed sm:text-xl">
          <p>
            Triatleta amateur competitivo con una rápida evolución en el deporte, destacándome en pruebas de corta y media distancia.
          </p>
          <p>
            En menos de 2 años logré posicionarme entre los mejores atletas de mi categoría, acumulando podios recurrentes y alcanzando
            la clasificación y participación en el Mundial de Ironman 70.3.
          </p>
        </div>
        <h3 class="mt-12 text-xl font-bold">Comprometido con</h3>
        <ul class="m-0 mt-3 list-none border-t-4 border-asfalto p-0">
          {COMMITMENTS.map((item) => <li class="display border-b border-asfalto/25 py-3 text-3xl sm:text-4xl">{item}</li>)}
        </ul>
        <div class="mt-12 flex items-center gap-5">
          <img src="/optimized/mutti-logo.png" alt="Logo de Mutti Triathlon" width="190" height="208" loading="lazy" class="h-24 w-auto" />
          <p class="text-lg leading-snug sm:text-xl">
            Entreno en <strong class="font-bold">Mutti Triathlon</strong>
            <span class="block">Coach: Francisco Mutti</span>
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Logros -->
  <section id="logros" class={`bg-asfalto ${SECTION}`}>
    <h2 class={HEADING}>Logros destacados</h2>
    <ul class="m-0 mt-10 list-none border-t-4 border-sol p-0">
      {
        ACHIEVEMENTS.map(({ date, title, detail, featured }) => (
          <li class="grid gap-1 border-b border-white/25 py-5 sm:gap-x-8 lg:grid-cols-12 lg:items-baseline">
            <span class:list={["font-semibold tabular-nums lg:col-span-2", featured ? "text-lg text-sol" : "text-dorsal/80"]}>{date}</span>
            <div class="min-w-0 lg:col-span-10">
              <h3 class:list={featured ? "display text-[clamp(2.25rem,4vw,3.5rem)] text-sol" : "text-xl font-bold sm:text-2xl"}>{title}<IronmanLogo race={title} /></h3>
              {detail && <p class:list={["mt-1", featured ? "text-lg font-medium sm:text-xl" : "text-dorsal/85"]}>{detail}</p>}
            </div>
          </li>
        ))
      }
    </ul>
  </section>

  <!-- Resultados -->
  <section id="resultados" class={`on-dorsal bg-dorsal text-asfalto ${SECTION}`}>
    <h2 class={`${HEADING} mb-12 text-azur`}>Resultados deportivos</h2>
    <ResultsTimeline blocks={RESULTS_TIMELINE} />
  </section>

  <!-- Próximas carreras -->
  <section id="proximas-carreras" class={`bg-buganvilla text-white ${SECTION}`}>
    <div class="grid gap-10 lg:grid-cols-12 lg:gap-x-8">
      <div class="lg:col-span-7">
        <h2 class={HEADING}>Próximas carreras</h2>
        {
          UPCOMING.map(({ year, featured, races }) => (
            <div class="mt-10">
              <h3 class="tiempo text-5xl sm:text-6xl">{year}</h3>
              <ul class="m-0 mt-3 list-none border-t-4 border-white p-0">
                {races.map(({ date, title, detail }) => (
                  <li class="border-b border-white/35 py-4">
                    <p class="font-semibold">{date}</p>
                    <p class:list={featured ? "display mt-1 text-[clamp(2.75rem,6vw,5rem)] text-sol" : "mt-1 text-2xl font-bold sm:text-3xl"}>{title}<IronmanLogo race={title} white /></p>
                    {detail && <p class="mt-2 text-xl font-semibold sm:text-2xl">{detail}</p>}
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
        <h3 class="mt-12 text-xl font-bold">Objetivos</h3>
        <ul class="m-0 mt-3 list-none border-t-4 border-white p-0 text-lg sm:text-xl">
          {GOALS.map((goal) => <li class="border-b border-white/35 py-3">{goal}</li>)}
        </ul>
      </div>
      <Photo
        photo={PHOTOS.bikeNice2}
        sizes="(min-width: 1024px) 40vw, 100vw"
        class="h-auto max-h-[85svh] w-full object-cover lg:sticky lg:top-20 lg:col-span-5 lg:self-start"
      />
    </div>
  </section>

  <!-- Galería -->
  <section id="galeria" class="scroll-mt-14 bg-asfalto py-16 md:py-24">
    <div class={GUTTER}>
      <h2 class={HEADING}>Galería</h2>
      <p class="mb-8 mt-4 max-w-[60ch] text-lg text-dorsal/85 sm:text-xl">Entrenamiento, competencias y el Mundial de Niza.</p>
    </div>
    <ImageCarousel images={CAROUSEL_IMAGES} />
  </section>

  <!-- Sponsorship -->
  <section id="sponsorship" class={`on-sol bg-sol text-asfalto ${SECTION}`}>
    <h2 class={HEADING}>Propuesta de sponsorship</h2>
    <p class="mt-8 max-w-[60ch] text-lg leading-relaxed sm:text-xl">
      Busco generar alianzas estratégicas con marcas que quieran acompañar este camino: del Mundial de Niza al Ironman Full San Juan 2027 y la
      búsqueda de la plaza para Kona.
    </p>
    <h3 class="mt-12 text-xl font-bold">¿Qué ofrezco?</h3>
    <ul class="m-0 mt-3 grid list-none gap-x-8 border-t-4 border-asfalto p-0 md:grid-cols-2">
      {OFFER.map((item) => <li class="border-b border-asfalto/30 py-5 text-xl font-semibold leading-snug sm:text-2xl">{item}</li>)}
    </ul>
  </section>

  <!-- Contacto -->
  <section id="contacto" class={`bg-azur text-white ${SECTION}`}>
    <h2 class={HEADING}>Contacto</h2>
    <div class="mt-10 max-w-4xl border-t-4 border-white">
      <a href={INSTAGRAM_URL} target="_blank" rel="noopener noreferrer" class={CONTACT_LINK}>
        Instagram @fransempe
        <svg class="h-7 w-7 shrink-0" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"
          ><path
            d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"
          ></path></svg
        >
      </a>
      <a href={WHATSAPP_URL} target="_blank" rel="noopener noreferrer" class={CONTACT_LINK}>
        WhatsApp
        <svg class="h-7 w-7 shrink-0" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"
          ><path
            d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.521-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.435 9.884-9.881 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"
          ></path></svg
        >
      </a>
      <a href={`mailto:${CONTACT_EMAIL}`} class={`${CONTACT_LINK} break-all`}>
        {CONTACT_EMAIL}
        <svg class="h-7 w-7 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"
          ><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path><polyline points="22,6 12,13 2,6"></polyline></svg
        >
      </a>
    </div>
  </section>
</LandingLayout>
